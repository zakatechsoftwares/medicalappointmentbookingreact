# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL. On Supabase: Project Settings → Database → Connection string.
# DATABASE_URL: the "Transaction pooler" URL (port 6543) — used by the running app.
# DIRECT_URL:   the "Session pooler" URL (port 5432) — used by `npm run migrate` and `npm run seed`.
DATABASE_URL=postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# For a local Postgres without SSL:
# DATABASE_URL=postgresql://postgres@localhost:5432/stayhealthy
# PGSSL=disable

# Long random string, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_ORIGIN=http://localhost:5173

PORT=8181
