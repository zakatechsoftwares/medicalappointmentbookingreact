# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_DB_NAME=stayhealthybeta1

# Long random string, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_ORIGIN=http://localhost:5173

PORT=8181
